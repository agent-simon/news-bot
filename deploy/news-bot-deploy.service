# Oneshot unit that runs auto-deploy.sh: pulls origin/main and, if there are
# new commits, syncs deps and restarts news-bot.service. Triggered on a
# schedule by news-bot-deploy.timer (install both).
#
# Requires passwordless sudo for the restart — see the sudoers snippet in
# README.md's auto-deploy section.

[Unit]
Description=Check for news-bot updates and deploy if changed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=youruser
WorkingDirectory=/home/youruser/work/news-bot
ExecStart=/home/youruser/work/news-bot/deploy/auto-deploy.sh
