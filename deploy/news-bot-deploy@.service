# Oneshot unit that runs auto-deploy.sh: pulls origin/main and, if there are
# new commits, syncs deps and restarts the bot. Triggered on a schedule by
# news-bot-deploy@.timer (install both).
#
# Templated: the instance name (%i) is the Linux user it runs as, with the
# checkout at /home/%i/work/news-bot — e.g. news-bot-deploy@alice.service.
# auto-deploy.sh restarts the matching news-bot@<user>.service itself.
#
# Requires passwordless sudo for the restart — see the sudoers snippet in
# README.md's auto-deploy section.

[Unit]
Description=Check for news-bot updates and deploy if changed (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=/home/%i/work/news-bot
ExecStart=/home/%i/work/news-bot/deploy/auto-deploy.sh
