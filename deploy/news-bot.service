# systemd unit for the news bot.
#
# Runs as the dedicated, unprivileged `newsbot` system account out of
# /opt/news-bot (the application's home). See README's "Running as a systemd
# service" section for the one-time account/dir setup.
#
# Dependencies are managed with uv. Create the .venv before first start:
#   uv sync
#
# Install on the Pi:
#   sudo cp deploy/news-bot.service /etc/systemd/system/news-bot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now news-bot.service
#   systemctl status news-bot.service
#   journalctl -u news-bot.service -f
#
# After a code update (auto-deploy does this for you):
#   git pull && uv sync && sudo systemctl restart news-bot.service

[Unit]
Description=News aggregator Telegram bot
# Wait for real network connectivity before starting (the bot needs it at boot).
After=network-online.target
Wants=network-online.target
# Stop restarting if it fails 5 times within 5 minutes (a hard failure, not a blip).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Dedicated unprivileged service account (no login shell). Its home is the app
# dir, so tools like uv have a writable HOME for their caches.
User=newsbot

# Unbuffer Python stdout/stderr so print() output reaches the journal in real
# time (otherwise it block-buffers when stdout isn't a terminal, and
# `journalctl -f` shows nothing until the buffer flushes).
Environment=PYTHONUNBUFFERED=1

# WorkingDirectory is load-bearing: seen_links.db / seen_links.json and the .env
# file are all resolved relative to it.
WorkingDirectory=/opt/news-bot

# Run the uv-managed virtualenv interpreter directly — the service does no
# dependency resolution at start (uv sync handles that at deploy time).
ExecStart=/opt/news-bot/.venv/bin/python /opt/news-bot/bot.py

# .env is loaded by python-dotenv from WorkingDirectory, so EnvironmentFile is
# optional. Uncomment to also surface the vars to systemd itself:
# EnvironmentFile=/opt/news-bot/.env

# Keep the always-on bot running across crashes and clean exits alike. The
# StartLimit* guard in [Unit] stops a fatal failure (bad token, broken pull)
# from restart-looping forever.
Restart=always
RestartSec=10

# --- Hardening ---
# Prevent the process (or anything it execs) from gaining new privileges.
NoNewPrivileges=true
# Give it a private /tmp, isolated from the rest of the system.
PrivateTmp=true
# Mount most of the filesystem read-only; ReadWritePaths below punches the
# one hole it actually needs (the checkout, for seen_links.db).
ProtectSystem=strict
ReadWritePaths=/opt/news-bot
# Fully hide /home, /root, /run/user/* from the service. Safe now that the app
# lives in /opt rather than a home dir (this is what broke the old templated
# unit with status=203/EXEC when the interpreter lived under /home).
ProtectHome=true
# No reason for a Telegram bot to load kernel modules, etc.
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
# Restrict to standard internet address families only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
