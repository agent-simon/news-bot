TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
CHAT_ID=
# Optional: set to off/false/0/no to disable the daily 08:00 auto-post
# (the /news command still works). Defaults to on when unset/empty.
DAILY_NEWS=
# Optional: set to off/false/0/no to skip the Claude web-search pass and use RSS
# feeds only (saves the Sonnet + web-search API cost). Defaults to on when unset/empty.
WEB_SEARCH=
# SSH target for scripts/pi-bot.sh (user@host)
PI_HOST=
