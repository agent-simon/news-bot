TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
CHAT_ID=
# Optional: set to off/false/0/no to disable the daily 08:00 auto-post
# (the /news command still works). Defaults to on when unset/empty.
DAILY_NEWS=
# Optional: set to off/false/0/no to skip the OpenAI web-search pass and use RSS
# feeds only. Defaults to on when unset/empty.
WEB_SEARCH=
# Optional: path to a feed/topic config read instead of the default root-level
# sources.local.json, so you can edit feeds/topics in place without a commit/deploy.
# Read fresh each run. Falls back to sources.local.json when unset.
SOURCES_PATH=
# SSH target for scripts/pi-bot.sh (user@host)
PI_HOST=
